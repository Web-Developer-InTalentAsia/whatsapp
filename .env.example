# ============================================================
# Paylix - Environment Variables
# Copy this file to .env and fill in real values before running
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=Paylix
ENVIRONMENT=production
DEBUG=false

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=paylix
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=paylix

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security — MUST change all of these ─────────────────────
# Minimum 32 characters, random
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_JWT_SECRET_KEY_HERE
# Must be exactly 32 bytes (pad or truncate to 32 chars)
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_ENCRYPTION_KEY_!!

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (OTP + notifications) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@paylix.lk
SMTP_FROM_NAME=Paylix
SMTP_TLS=true

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
TOTP_ISSUER=Paylix

# ── CORS ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,https://app.paylix.lk

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── File storage ─────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/uploads
# For S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1

# ── Celery ───────────────────────────────────────────────────
CELERY_TIMEZONE=Asia/Colombo

# ── Flower (Celery UI) ───────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD

# ── Payroll defaults (overridable per company via PayrollRule) ─
DEFAULT_EPF_EMPLOYEE_RATE=0.08
DEFAULT_EPF_EMPLOYER_RATE=0.12
DEFAULT_ETF_EMPLOYER_RATE=0.03
DEFAULT_OT_MULTIPLIER=1.5
DEFAULT_HOLIDAY_OT_MULTIPLIER=2.0
DEFAULT_WORKING_DAYS_PER_MONTH=26
